@using System
@using System.Linq
@using Ams.Media.Web.Dto
@model PagedResult<ClientGridRow>

@{
    // ดึงค่าออกจาก PagedResult<T> ด้วย Deconstruct (ตาม DTO\PagedResult.cs)
    var (items, total, page, pageSize) = Model;

    // ปลอดภัยต่อศูนย์/ค่าผิดปกติ
    page = page <= 0 ? 1 : page;
    pageSize = pageSize <= 0 ? 50 : pageSize;

    var totalPages = Math.Max(1, (int)Math.Ceiling(total / (double)pageSize));
    var hasPrev = page > 1;
    var hasNext = page < totalPages;

    // เดิมเคยใช้ Model.Show -> ไม่มีใน PagedResult<T>
    // ใช้ค่าจาก ViewBag/Query แทน (A=All, C=ซ่อน Not Use)
    var show = (string?)(ViewBag.Show ?? Context?.Request?.Query["show"].ToString()) ?? "A";
}

<div class="table-responsive">
    <table class="table table-sm table-dark table-hover align-middle">
        <thead>
            <tr>
                <th style="width:100px;">ID</th>
                <th>Name</th>
                <th style="width:90px;">Prefix</th>
                <th style="width:160px;">Tax ID</th>
                <th style="width:110px;" class="text-center">Status</th>
                <th style="width:210px;" class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (items is { Count: > 0 })
            {
                foreach (var item in items.OrderBy(x => x.ClientId))
                {
                    var statusText = item.ClientStatus == 1 ? "In Use" : "Not Use";
                    var statusClass = item.ClientStatus == 1 ? "text-success" : "text-secondary";

                    <tr>
                        <td>@item.ClientId</td>
                        <td class="text-wrap">@item.Description</td>
                        <td>@item.ClientPrefix</td>
                        <td>@item.ClientTaxNo</td>
                        <td class="text-center"><span class="@statusClass">@statusText</span></td>
                        <td class="text-end">
                            <a asp-controller="Client"
                               asp-action="Address"
                               asp-route-id="@item.ClientId"
                               class="btn btn-outline-secondary btn-sm me-1">Address</a>

                            <a asp-controller="Client"
                               asp-action="Edit"
                               asp-route-id="@item.ClientId"
                               class="btn btn-primary btn-sm me-1">Edit</a>

                            <form asp-controller="Client"
                                  asp-action="Delete"
                                  asp-route-id="@item.ClientId"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Delete client @item.ClientId ?');">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No clients.</td></tr>
            }
        </tbody>
    </table>
</div>

<nav class="d-flex justify-content-between align-items-center mt-2">
    <div class="small text-muted">
        @{
            var from = total == 0 ? 0 : ((page - 1) * pageSize + 1);
            var to = Math.Min(total, page * pageSize);
        }
        Showing @from–@to of @total
    </div>

    <div class="btn-group">
        <a class="btn btn-outline-light btn-sm @(hasPrev ? "" : "disabled")"
           asp-controller="Client"
           asp-action="App"
           asp-route-page="@(page - 1)"
           asp-route-pageSize="@pageSize"
           asp-route-show="@show">Prev</a>

        <a class="btn btn-outline-light btn-sm @(hasNext ? "" : "disabled")"
           asp-controller="Client"
           asp-action="App"
           asp-route-page="@(page + 1)"
           asp-route-pageSize="@pageSize"
           asp-route-show="@show">Next</a>
    </div>
</nav>
