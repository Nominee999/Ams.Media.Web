@using Ams.Media.Web.Dto
@model ClientRow
@{
    var inModal = (bool?)ViewBag.InModal == true;
    if (inModal) { Layout = null; }

    // ใช้แฟลกจาก Controller เป็นหลัก เพื่อไม่ให้ "New ที่มี ClientId ถัดไป" กลายเป็น Update
    var isNew = (bool?)ViewBag.IsNew ?? ((Model?.ClientId ?? 0) == 0);

    ViewData["Title"] = (isNew ? "New" : "Edit") + " Client";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="container @(inModal ? "p-0" : "py-3")">
    @if (!inModal)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">@ViewData["Title"]</h4>
            <a asp-action="App" class="btn btn-outline-secondary btn-sm">Back to List</a>
        </div>
    }

    <form asp-action="@(isNew ? "Create" : "Update")" method="post" class="card shadow-sm p-3">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <!-- Hidden: ทำให้ ClientId โพสต์กลับเสมอ -->
        <input type="hidden" asp-for="ClientId" />

        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Client ID</label>
                <!-- ใช้ readonly (ไม่ใช้ disabled เพราะ disabled จะไม่ถูกโพสต์) -->
                <input class="form-control" value="@(Model?.ClientId == 0 ? "(auto)" : Model!.ClientId.ToString())" readonly />
            </div>

            <div class="col-md-3">
                <label asp-for="ClientPrefix" class="form-label">Prefix</label>
                <input asp-for="ClientPrefix" class="form-control" maxlength="4" pattern="[A-Za-z0-9]{2,4}" required />
                <span asp-validation-for="ClientPrefix" class="text-danger"></span>
                <small class="text-muted">2–4 ตัวอักษร/ตัวเลข, ไม่เว้นวรรค</small>
            </div>

            <div class="col-md-6">
                <label asp-for="Description" class="form-label">Client Name</label>
                <input asp-for="Description" class="form-control" maxlength="50" required />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ClientBranch" class="form-label">Branch</label>
                <input asp-for="ClientBranch" class="form-control" />
            </div>

            <div class="col-md-3">
                <label asp-for="AgencyCom" class="form-label">Agency Com (%)</label>
                <input asp-for="AgencyCom" class="form-control" type="number" step="0.01" min="0" max="100" />
                <span asp-validation-for="AgencyCom" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="CreditTerm" class="form-label">Credit Term (days)</label>
                <input asp-for="CreditTerm" class="form-control" type="number" min="0" max="365" />
                <span asp-validation-for="CreditTerm" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ClientTaxNo" class="form-label">Tax ID</label>
                <input asp-for="ClientTaxNo" class="form-control" maxlength="13" />
                <span asp-validation-for="ClientTaxNo" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ClientStatus" class="form-label">Status</label>
                <select asp-for="ClientStatus" class="form-select">
                    <option value="0">Not Use</option>
                    <option value="1">In Use</option>
                </select>
                <span asp-validation-for="ClientStatus" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label">Branch Type</label>
                <input class="form-control" value="@Model?.BranchType" readonly />
                <input type="hidden" asp-for="BranchType" />
            </div>
        </div>

        <div class="mt-4 d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            @if (inModal)
            {
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            }
            else
            {
                <a asp-action="App" class="btn btn-outline-secondary">Cancel</a>
            }
        </div>
    </form>
</div>
