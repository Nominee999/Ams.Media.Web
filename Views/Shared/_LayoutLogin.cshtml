@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    // อ่าน default จาก JSON และ override ด้วย cookie
    var themeDefault = (Configuration?["Ui:ThemeDefault"] ?? "dark").Trim().ToLowerInvariant();
    if (themeDefault != "dark" && themeDefault != "light") themeDefault = "dark";
    var cookieTheme = Context.Request.Cookies.TryGetValue("Theme", out var t) ? t : null;
    var theme = (cookieTheme ?? themeDefault).Trim().ToLowerInvariant();
    if (theme != "dark" && theme != "light") theme = "dark";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Sign in") - AMS Media</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        /* อย่าบังคับ light: ใช้สีตามตัวแปรของธีม */
        body {
            background: var(--bs-body-bg);
            color: var(--bs-body-color);
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
        }

        .login-container {
            width: 100%;
            max-width: 520px;
        }

        .card {
            border: 0;
            border-radius: 18px;
            /* เงานุ่ม ๆ ใช้ค่ากลาง ไม่ขาว/ดำตายตัว */
            box-shadow: 0 18px 50px rgba(0,0,0,.12);
            overflow: hidden;
            background: var(--bs-body-bg);
            color: var(--bs-body-color);
        }

        .card-body {
            padding: 28px;
        }

        h3 {
            font-weight: 600;
        }
    </style>
</head>
<body>
    <main class="login-container">
        <div class="card">
            <div class="card-body text-center">
                <img src="~/img/ams_logo.png" alt="AMS Media" class="mb-3" style="max-height:80px;" />
                @RenderBody()
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
