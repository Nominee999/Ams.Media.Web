@using System.Linq
@using Ams.Media.Web.Models
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Ams.Media.Web.Services.IMenuGate Gate
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    // เก็บ Anti-forgery token ลง meta
    var tokens = Antiforgery.GetAndStoreTokens(Context);
    var title = ViewData["Title"] as string ?? "AMS Media";
    var uname = User?.Identity?.Name ?? "";

    var mItems = (await Gate.GetSubMenusAsync('M', uname))?.ToList() ?? new List<MenuItemVm>();
    var tItems = (await Gate.GetSubMenusAsync('T', uname))?.ToList() ?? new List<MenuItemVm>();
    var rItems = (await Gate.GetSubMenusAsync('R', uname))?.ToList() ?? new List<MenuItemVm>();
    var eItems = (await Gate.GetSubMenusAsync('E', uname))?.ToList() ?? new List<MenuItemVm>();
    var aItems = (await Gate.GetSubMenusAsync('A', uname))?.ToList() ?? new List<MenuItemVm>();
    var sItems = (await Gate.GetSubMenusAsync('S', uname))?.ToList() ?? new List<MenuItemVm>();

    var acMode = (Configuration?["ShowData"] ?? "C").Trim().ToUpperInvariant();
    if (acMode != "A" && acMode != "C") acMode = "C";

    var themeDefault = (Configuration?["Ui:ThemeDefault"] ?? "dark").Trim().ToLowerInvariant();
    if (themeDefault != "dark" && themeDefault != "light") themeDefault = "dark";
    var themeCookie = Context.Request.Cookies.TryGetValue("Theme", out var tc) ? tc : null;
    var theme = (themeCookie ?? themeDefault).Trim().ToLowerInvariant();
    if (theme != "dark" && theme != "light") theme = "dark";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="@theme">
<head>
    <meta charset="utf-8" />
    <title>@title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="request-verification-token" content="@tokens.RequestToken" />
    @RenderSection("Styles", required: false)

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg border-bottom">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">AMS</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (mItems.Any())
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Master</a>
                                <ul class="dropdown-menu">
                                    @foreach (var it in mItems)
                                    {
                                        <li>
                                            @if (!string.IsNullOrWhiteSpace(it.Controller) && !string.IsNullOrWhiteSpace(it.Action))
                                            {
                                                <a class="dropdown-item" asp-controller="@it.Controller" asp-action="@it.Action">
                                                    @if (!string.IsNullOrWhiteSpace(it.Icon))
                                                    {
                                                        <i class="@it.Icon"></i>
                                                    }
                                                    @it.Text
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="dropdown-item" href="@it.Url">
                                                    @if (!string.IsNullOrWhiteSpace(it.Icon))
                                                    {
                                                        <i class="@it.Icon"></i>
                                                    }
                                                    @it.Text
                                                </a>
                                            }
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (tItems.Any())
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Transaction</a>
                                <ul class="dropdown-menu">
                                    @foreach (var it in tItems)
                                    {
                                        <li>
                                            @if (!string.IsNullOrWhiteSpace(it.Controller) && !string.IsNullOrWhiteSpace(it.Action))
                                            {
                                                <a class="dropdown-item" asp-controller="@it.Controller" asp-action="@it.Action">@it.Text</a>
                                            }
                                            else
                                            {
                                                <a class="dropdown-item" href="@it.Url">@it.Text</a>
                                            }
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (rItems.Any())
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Report</a>
                                <ul class="dropdown-menu">
                                    @foreach (var it in rItems)
                                    {
                                        <li>
                                            @if (!string.IsNullOrWhiteSpace(it.Controller) && !string.IsNullOrWhiteSpace(it.Action))
                                            {
                                                <a class="dropdown-item" asp-controller="@it.Controller" asp-action="@it.Action">@it.Text</a>
                                            }
                                            else
                                            {
                                                <a class="dropdown-item" href="@it.Url">@it.Text</a>
                                            }
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (eItems.Any())
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Enquiry</a>
                                <ul class="dropdown-menu">
                                    @foreach (var it in eItems)
                                    {
                                        <li>
                                            @if (!string.IsNullOrWhiteSpace(it.Controller) && !string.IsNullOrWhiteSpace(it.Action))
                                            {
                                                <a class="dropdown-item" asp-controller="@it.Controller" asp-action="@it.Action">@it.Text</a>
                                            }
                                            else
                                            {
                                                <a class="dropdown-item" href="@it.Url">@it.Text</a>
                                            }
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (aItems.Any())
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Admin</a>
                                <ul class="dropdown-menu">
                                    @foreach (var it in aItems)
                                    {
                                        <li>
                                            @if (!string.IsNullOrWhiteSpace(it.Controller) && !string.IsNullOrWhiteSpace(it.Action))
                                            {
                                                <a class="dropdown-item" asp-controller="@it.Controller" asp-action="@it.Action">@it.Text</a>
                                            }
                                            else
                                            {
                                                <a class="dropdown-item" href="@it.Url">@it.Text</a>
                                            }
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (sItems.Any())
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">System</a>
                                <ul class="dropdown-menu">
                                    @foreach (var it in sItems)
                                    {
                                        <li>
                                            @if (!string.IsNullOrWhiteSpace(it.Controller) && !string.IsNullOrWhiteSpace(it.Action))
                                            {
                                                <a class="dropdown-item" asp-controller="@it.Controller" asp-action="@it.Action">@it.Text</a>
                                            }
                                            else
                                            {
                                                <a class="dropdown-item" href="@it.Url">@it.Text</a>
                                            }
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <form hx-post="/flags/showdata/toggle" hx-swap="outerHTML" class="d-inline">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                <span class="me-1">A/C</span>
                                <span class="badge text-bg-light">@acMode</span>
                            </button>
                        </form>
                        <span id="ThemeToggleHost">
                            @await Html.PartialAsync("~/Views/Shared/Partials/_ThemeToggle.cshtml")
                        </span>
                        <form asp-controller="Account" asp-action="LogoutPost" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-3 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="site-footer py-3 mt-auto">
        <div class="container small">
            © @DateTime.Now.Year AMS Media
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <script>
        document.body.addEventListener('htmx:configRequest', function (evt) {
            var token = document.querySelector('meta[name="request-verification-token"]')?.content;
            if (token) evt.detail.headers['RequestVerificationToken'] = token;
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
